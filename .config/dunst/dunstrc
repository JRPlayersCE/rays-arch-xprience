[global]
    corner_radius = 8
    font = JetBrainsMono Nerd Font 10
    frame_width = 2
    origin = bottom-right

[urgency_low]
    background = "#2f383e"
    foreground = "#83c092"
    frame_color = "#83c092"
    timeout = 4

[urgency_normal]
    background = "#2f383e"
    foreground = "#d3c6aa"
    frame_color = "#a7c080"
    timeout = 8

[urgency_critical]
    background = "#2f383e"
    foreground = "#e67e80"
    frame_color = "#e67e80"
    timeout = 0
